# Public browser credentials from Supabase Dashboard > Project Settings > API.
# Use the project API URL (https://PROJECT_REF.supabase.co), not the dashboard URL.
#
# IMPORTANT SECURITY NOTES:
# 1. Variables prefixed with VITE_ are public browser configuration bundled into client assets.
# 2. The Supabase publishable (anon) key is safe for client-side use when protected by PostgreSQL RLS.
# 3. NEVER add Supabase service-role keys, database master passwords, or private API secrets here.
# 4. Copy this template to .env.local for local development (.env.local is strictly git-ignored).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional: only needed if a separate custom API is added later.
VITE_API_BASE_URL=
